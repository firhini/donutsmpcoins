# ───────────── Admin ─────────────
# Password for /admin (required for the admin panel)
ADMIN_PASSWORD=change-me-now
# Optional: separate secret for signing admin sessions (defaults to a hash of ADMIN_PASSWORD)
ADMIN_SECRET=

# ───────────── Discord login (lets players sign in to spin the wheel & see their orders) ─────────────
# Discord Developer Portal → New Application → OAuth2: copy Client ID + Client Secret and add the redirect URL
#   https://<your-site>/api/auth/discord/callback   (and http://localhost:5173/api/auth/discord/callback for local dev)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: your Discord server id – players must be a member to spin (enable "require membership" in the admin)
DISCORD_GUILD_ID=
# Optional: separate secret for signing login cookies (defaults to ADMIN_SECRET / ADMIN_PASSWORD)
SESSION_SECRET=

# ───────────── Notifications ─────────────
# Discord webhook: new orders, payments, spin wins, giveaway entries land here
DISCORD_WEBHOOK_URL=

# ───────────── Payments (all optional – manual methods work without any of these) ─────────────
# Stripe (card / Apple Pay / Google Pay). Needs a Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal Checkout (REST app credentials). Leave empty to use the simple PayPal.me manual method instead.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
# NOWPayments (crypto invoices, low verification requirements)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Public site URL (used in payment redirects, e.g. https://donutcoins.netlify.app)
SITE_URL=
